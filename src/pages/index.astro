/* ── PLUMHQ.COM CHROME, BYLINE AND DOCK (as on /india-benefits-stack) ── */
@font-face { font-family: 'IBM Plex Mono'; src: url('/fonts/IBMPlexMono-Medium.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
:root { --chrome-nav-h: 70px; --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }
html { scroll-padding-top: calc(var(--chrome-nav-h) + 64px); }
.skip-link { position: absolute; left: 12px; top: -60px; z-index: 1100; background: var(--fg-1); color: var(--cream); padding: 10px 14px; border-radius: 6px; font: 600 14px/1 var(--font-sans); }
.skip-link:focus { top: 12px; }
/* The fixed bar sits over the masthead; the contents bar docks under it. */
.masthead { padding: calc(var(--chrome-nav-h) + clamp(20px,4vw,40px)) clamp(20px,5vw,64px) clamp(28px,4vw,44px); }
.masthead h1 { margin-bottom: 16px; }
.masthead-sub { margin-bottom: 20px; }
.masthead-meta { padding-top: 16px; }
/* Desktop: title left, intro right (as on /india-benefits-stack), so the
   red section is about half as tall and the guide starts on the first screen. */
@media (min-width: 1024px) {
  .masthead-inner { max-width: 1180px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); column-gap: clamp(40px, 5vw, 80px);
    grid-template-areas: "eyebrow eyebrow" "title sub" "title meta"; align-items: start; }
  .masthead-eyebrow { grid-area: eyebrow; }
  .masthead h1 { grid-area: title; margin-bottom: 0; font-size: clamp(44px, 4.6vw, 62px); }
  .masthead-sub { grid-area: sub; max-width: none; margin-bottom: 16px; padding-top: 8px; }
  .masthead-meta { grid-area: meta; }
}
.toc-bar { top: var(--chrome-nav-h); }
/* The plumhq.com bar is transparent over the coral hero and dark once the
   guide reaches it (nav-script.html toggles .nav--scrolled). Its logo is coral,
   which vanishes on coral, so it goes cream until the dark bar fades in; the
   coral "Get a quote" button inverts for the same reason. */
.navbar:not(.nav--scrolled):not(.nav--menu-open) .nav-logo { color: var(--fg-on-red); }
@media (min-width: 992px) {
  .navbar:not(.nav--scrolled):not(:has(.nav-item:hover)) .get-quote-button { background-color: var(--cream); color: var(--plum-red); }
}

/* Small laptops (992–1279 px): plumhq.com's live bar tightens here; the
   extract in chrome.css predates that, so the logo met "Product" and the quote
   button wrapped. Matches the live values measured at 1024 px. */
.get-quote-button { white-space: nowrap; }
@media (min-width: 992px) and (max-width: 1279px) {
  .nav-container-3 { width: auto; margin-left: 24px; margin-right: 24px; }
  .nav-item-link { padding-left: 12px; padding-right: 12px; }
}

/* Byline */
.byline { display: flex; align-items: center; gap: 12px; margin: 14px 0 0; }
.byline-photo { width: 44px; height: 44px; border-radius: 50%; flex: none; object-fit: cover; }
.byline-line { display: inline-flex; align-items: center; gap: 8px; }
.byline-social { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 5px; color: var(--fg-2); transition: color .16s ease; }
.byline-social:hover { color: #0A66C2; }
.byline-social svg { width: 16px; height: 16px; fill: currentColor; display: block; }
.byline-initials { display: grid; place-items: center; background: var(--fg-1); color: var(--cream); font: 600 14px/1 var(--font-sans); letter-spacing: .04em; }
.byline-text { display: grid; gap: 3px; font-size: 15px; line-height: 1.3; color: var(--fg-1); }
.byline-name { font-weight: 600; color: inherit; }
a.byline-name { text-decoration: underline; text-decoration-color: rgba(255, 64, 82, .5); text-underline-offset: 3px; }
.byline-role { font-size: 13px; color: var(--fg-muted); }
.hub-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px; padding-top: 28px; }
.hub-head .byline { margin: 0; }
.hub-head .hub-tools { padding-top: 0; }

.hub-head { padding-top: 32px; }
/* ── DOCK (as on /standard-of-employee-benefits) ──────────────────────── */
.dock {
  position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 120; /* above the sticky contents bar (100) */
  display: flex; flex-direction: column; align-items: stretch; gap: 10px;
  pointer-events: none; transition: opacity .22s ease, visibility .22s;
}
.dock-row { display: flex; align-items: stretch; gap: 8px; }
.dock-btn, .dock-ai-link { pointer-events: auto; }
.dock-btn {
  box-sizing: border-box; height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  padding: 0 20px 0 16px; border-radius: 14px; border: 1.5px solid rgb(255 248 242 / 30%);
  background: rgb(29 7 22 / 88%); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  color: #FFF8F2; font: 500 15px/1 var(--font-sans); text-decoration: none; white-space: nowrap; cursor: pointer;
  box-shadow: 0 8px 24px rgb(14 3 11 / 24%);
  transition: background-color .16s ease, border-color .16s ease, color .16s ease, transform .16s ease, opacity .18s ease, visibility .18s;
}
.dock-btn svg { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.dock-top { width: 48px; padding: 0; background: #3A1830; border-color: #3A1830; }
.dock-top svg { transition: transform .25s ease; }
.dock:not(.is-past) .dock-top svg { transform: rotate(180deg); }
.dock-btn:hover { background: var(--plum-red); border-color: var(--plum-red); color: #fff; }
.dock-btn:active { transform: translateY(1px); }
.dock-btn:focus-visible { outline: 2px solid var(--plum-red); outline-offset: 3px; }
.dock.is-quiet .dock-talk { opacity: 0; visibility: hidden; pointer-events: none; }
.navbar.nav--menu-open ~ .dock { opacity: 0; visibility: hidden; }

.dock-ai {
  display: grid; justify-items: stretch; gap: 6px; pointer-events: auto;
  padding: 9px 6px 3px; border-radius: 16px;
  background: rgb(29 7 22 / 88%); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  border: 1.5px solid rgb(255 248 242 / 14%); box-shadow: 0 8px 24px rgb(14 3 11 / 24%);
  transition: opacity .22s ease, visibility .22s, border-color .22s ease;
}
.dock-ai-label, .dock-ai-tools { transition: opacity .2s ease; }
.dock.is-past .dock-ai-label, .dock.is-past .dock-ai-tools { opacity: .6; }
.dock.is-past .dock-ai:hover, .dock.is-past .dock-ai:focus-within { border-color: rgb(255 248 242 / 32%); }
.dock.is-past .dock-ai:hover > *, .dock.is-past .dock-ai:focus-within > * { opacity: 1; }
body.at-footer .dock-ai, .dock.is-quiet .dock-ai { opacity: 0; visibility: hidden; }
/* Both states: the talk row runs the full width of the AI card above it. */
.dock-talk { flex: 1; }
.dock-ai-label { margin: 0; padding-left: 8px; font: 400 14px/1.35 var(--font-sans); color: #FFF8F2; text-align: left; max-width: 260px; }
/* Four equal columns: the icons spread evenly edge to edge, whatever the label's width. */
.dock-ai-tools { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: center; margin: 0; padding: 0; list-style: none; }
.dock-ai-tools li { display: flex; align-items: center; justify-content: center; margin: 0; }
.dock-ai-tools li + li { box-shadow: inset 1px 0 0 rgb(255 248 242 / 26%); }
.dock-ai-link { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; color: var(--cream); transition: color .16s ease, transform .16s ease; }
.dock-ai-link svg { display: block; width: auto; height: 23px; }
.dock-ai-link:hover { color: var(--plum-red); }
.dock-ai-link:focus-visible { outline: 2px solid var(--plum-red); outline-offset: 0; }
@media (prefers-reduced-motion: reduce) { .dock-ai, .dock-ai-label, .dock-ai-tools, .dock-btn { transition: none; } }
@media (max-width: 480px) { .dock-btn { height: 46px; font-size: 14.5px; padding: 0 16px 0 14px; gap: 8px; } .dock-top { width: 46px; padding: 0; } }
@media (max-width: 760px) {
  .dock.is-past .dock-ai { padding: 3px 6px; gap: 0; }
  .dock.is-past .dock-ai-label { display: none; }
}
.dock-talk-short { display: none; }
/* Phones: always one slim row across the bottom (AI tools under a short
   caption, then the talk pill) so it never covers the board or a third of
   the text. */
.dock-ai-short { display: none; }
@media (max-width: 560px) {
  .dock { left: max(12px, env(safe-area-inset-left)); right: max(12px, env(safe-area-inset-right)); bottom: max(12px, env(safe-area-inset-bottom)); flex-direction: row; align-items: stretch; gap: 8px; }
  .dock .dock-ai { display: grid; justify-items: center; gap: 0; padding: 4px 4px 0; }
  .dock .dock-ai-label { display: none; }
  .dock .dock-ai-short { display: block; font: 500 10px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: rgb(255 248 242 / 72%); }
  .dock .dock-ai-tools, .dock.is-past .dock-ai-tools { opacity: .95; }
  .dock.is-past .dock-ai { padding: 4px 4px 0; }
  .dock .dock-ai-link { width: 36px; height: 34px; }
  .dock .dock-ai-link svg { height: 19px; }
  .dock .dock-ai-tools li + li::before { height: 16px; margin: 0 3px; }
  .dock .dock-row { flex: 1; min-width: 0; }
  .dock .dock-talk { flex: 1; min-width: 0; height: auto; min-height: 46px; padding: 0 12px; }
  .dock .dock-top { display: none; }
  .dock .dock-talk-long { display: none; }
  .dock .dock-talk-short { display: inline; }
}
@media print { .dock, .xi { display: none !important; } }

/* The section stepper moves left so the dock holds the right corner;
   on phones the dock rides above the stepper's bottom bar. */
@media (min-width:641px){ .deck-ctl{ right:auto; left:clamp(16px,3vw,36px); } }
@media (max-width:640px){ .dock{ transition:opacity .22s ease, visibility .22s, bottom .2s ease-out; } body:has(.deck-ctl.on) .dock{ bottom:calc(max(12px, env(safe-area-inset-bottom)) + 64px); } }

/* Former "In full" accordions, now always-open body copy under the section */
.detail-body { padding: 0; border-top: none; margin-top: 28px; }
