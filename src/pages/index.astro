---
// Group health insurance cost guide (India, 2026)
// Served under the mount path (astro.config.mjs), so local files are linked
// through `base` rather than from the site root.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="en-IN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Group Health Insurance Cost per Employee in India (2026) | Plum</title>
<meta name="description" content="Half of Indian companies spend ₹6,000–24,000 per employee a year on group health insurance. See costs by company size, what moves premiums, and how to budget.">
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
<link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`}>
<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`}>
<meta name="theme-color" content="#FF4052">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Plum">
<meta property="og:title" content="Group Health Insurance Cost per Employee in India (2026)">
<meta property="og:description" content="Half of Indian companies spend ₹6,000–24,000 per employee a year on group health insurance. See costs by company size, what moves premiums, and how to budget.">
<meta property="og:url" content="https://www.plumhq.com/group-health-insurance-cost">
<meta property="og:locale" content="en_IN">
