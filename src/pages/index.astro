    'parental-cover-the-fastest-growing-and-most-under-provisione': 'Want parental cover that actually makes sense? Talk to an expert.',
    'esic-and-group-health-insurance-together': 'Want help layering ESIC with private cover? Talk to an expert.',
    'how-to-budget-for-group-health-insurance': 'Want help building a defensible budget? Talk to an expert.',
    'benefits-calculator': 'Want a full benchmark of your plan? Talk to an expert.',
    'by-the-numbers': 'Want these numbers interpreted for your company? Talk to an expert.',
    'frequently-asked-questions': 'Have a question we did not cover? Talk to an expert.'
  };
  var rail = document.querySelector('.sales-rail');
  var copy = document.getElementById('sales-rail-copy');
  if (!rail || !copy) return;
  var sections = Array.prototype.slice.call(document.querySelectorAll('section[id]'));
  if (!sections.length) return;
  var last = null;
  function update(){
    var mid = window.innerHeight * 0.4;
    var cur = sections[0];
    sections.forEach(function(s){
      if (s.getBoundingClientRect().top <= mid) cur = s;
    });
    var id = cur.id;
    if (id === last) return;
    last = id;
    var text = COPY[id] || COPY['overview'];
    copy.textContent = text;
    rail.classList.add('is-fade');
    setTimeout(function(){ rail.classList.remove('is-fade'); }, 120);
  }
  var tick = false;
  window.addEventListener('scroll', function(){
    if (!tick) {
      requestAnimationFrame(function(){ update(); tick = false; });
      tick = true;
    }
  }, {passive: true});
  update();
})();
</script>
