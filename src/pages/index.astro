    return {si:+g('si'),fam:g('fam'),mat:+g('mat'),copay:+g('copay'),gpa:c('gpa'),gtl:c('gtl'),chk:c('chk'),tele:c('tele'),mw:c('mw'),opd:c('opd'),dental:c('dental'),vision:c('vision'),coh:g('coh')}}
  function scores(s){
    var I=D.ins,H=D.hc;
    var ins=I._b+I.lsi*Math.log(Math.min(s.si,2500000)/100000)+(s.fam!=='e'?I.fam:0)+(s.fam==='par'?I.par:0)
      +(s.mat>0?I.mat+I.matl*Math.log(1+Math.min(s.mat,200000)/50000):0)+I.nocopay*(1-Math.min(s.copay/10,2)/2)+(s.gtl?I.has_gtl:0)+(s.gpa?I.has_gpa:0);
    var w=[s.opd,s.tele,s.mw,s.chk,s.dental,s.vision],n=w.filter(Boolean).length;
    var hc=H._b+(s.opd?H.has_opd:0)+(s.tele?H.has_telehealth:0)+(s.mw?H.has_mentalwellness:0)+(s.chk?H.has_healthcheckups:0)+(s.dental?H.has_dental:0)+(s.vision?H.has_vision:0)+(n>=1?H.nw1:0)+(n>=2?H.nw2:0)+(n>=3?H.nw3:0);
    ins=Math.max(0,Math.min(100,ins)); hc=Math.max(0,Math.min(100,hc)); return {ins:ins,hc:hc,tot:ins+hc}}
  function pct(arr,v){var lo=Math.floor(v),hi=Math.min(arr.length-1,lo+1),t=v-lo;lo=Math.max(0,Math.min(arr.length-1,lo));return (arr[lo]*(1-t)+arr[hi]*t)*100}
  function ord(n){var s=['th','st','nd','rd'],v=n%100;return n+(s[(v-20)%10]||s[v]||s[0])}
  function in10(x){return x>=95?'nearly all':x<5?'fewer than 1 in 10':Math.round(x/10)+' in 10'}
  function r5(p){return Math.max(5,Math.min(95,Math.round(p/5)*5))}
  function pctOf(s){return pct(D.cdf_tot[s.coh],scores(s).tot)}
  function inr(v){return '₹'+v.toLocaleString('en-IN')}
  function sib(si){return si<300000?'lt3':si<500000?'3to5':si<750000?'5to7':si<1000000?'7to10':si<1500000?'10to15':'15p'}
  function moves(s,base){
    var c=[],cl=function(o){var x={};for(var k in s)x[k]=s[k];for(var k2 in o)x[k2]=o[k2];return x},P=D.prev;
    var i=SI.indexOf(s.si); if(i<SI.length-1){var ns=SI[Math.min(SI.length-1,s.si<750000?SI.indexOf(750000):i+1)];c.push(['Raise sum insured to '+(ns>=2000000?'₹20 lakh':'₹'+(ns/100000)+' lakh'),cl({si:ns}),'si75'])}
    if(s.fam==='e')c.push(['Cover spouse and children',cl({fam:'esc'}),'fam']);
    if(s.fam!=='par')c.push(['Add parents to the policy',cl({fam:'par'}),'par']);
    if(s.mat===0)c.push(['Add maternity cover',cl({mat:50000}),'mat']); else if(s.mat<100000)c.push(['Raise the maternity limit to ₹1 lakh',cl({mat:100000}),'mat']);
    if(s.copay>0)c.push(['Remove the co-pay',cl({copay:0}),'nocopay']);
    [['chk','Add health check-ups','has_healthcheckups'],['tele','Add telehealth','has_telehealth'],['mw','Add mental wellness','has_mentalwellness'],['opd','Add OPD cover','has_opd'],['dental','Add dental','has_dental'],['gpa','Add accident cover (GPA)','has_gpa'],['gtl','Add term life (GTL)','has_gtl']].forEach(function(m){if(!s[m[0]]){var o={};o[m[0]]=true;c.push([m[1],cl(o),m[2]])}});
    c.forEach(function(x){x.push(pctOf(x[1])-base)});
    return c.filter(function(x){return x[3]>=2.5}).sort(function(a,b){return b[3]-a[3]}).slice(0,3)}
  function render(){
    var s=read(),sc=scores(s),p=pctOf(s),r=r5(p),top=100-r;
    $('c-top').textContent=ord(r)+' percentile'; $('c-mini').textContent=ord(r)+' percentile';
    $('c-sub').textContent='Richer than about '+r+'% of '+NAMES[s.coh]+' on Plum.';
    $('c-fill').style.width=p+'%'; $('c-mark').style.left=p+'%';
    $('c-ins').textContent=ord(r5(pct(D.cdf_ins,sc.ins)))+' percentile'; $('c-hc').textContent=sc.hc<1?'None yet':ord(r5(pct(D.cdf_hc,sc.hc)))+' percentile';
    var q=sc.ins>=55?(sc.hc>=35?'Holistic leader':'Insurance-strong'):(sc.hc>=35?'Wellness-forward':'Starter');
    $('c-quad').innerHTML='<strong>'+q+'.</strong> '+QD[q];
    $('c-dot').style.left=sc.hc+'%'; $('c-dot').style.bottom=sc.ins+'%';
    var k=sib(s.si)+'|'+s.fam, sp=D.spend[k]||D.spend['*|'+s.fam];
    $('c-spend').textContent=inr(sp[0])+' – '+inr(sp[1]);
    var mv=moves(s,p),ol=$('c-moves');
    ol.innerHTML=mv.length?mv.map(function(m){var pv=D.prev[m[2]],why=pv?'In '+in10(pv[0])+' top-quarter plans, against '+in10(pv[1])+' overall':'';
      return '<li><span>'+m[0]+'</span><span class="gain">to '+ord(r5(p+m[3]))+'</span>'+(why?'<span class="why">'+why+'</span>':'')+'</li>'}).join(''):'<li class="none">Your plan already sits near the top for this group. A full benchmark can show where the details, such as sub-limits and waiting periods, still differ.</li>';
  }
  f.addEventListener('change',render); render();
})();

(function () {
  var html = document.documentElement;
  // ── Share, as on /india-benefits-stack: copy link, native share where the
  // browser has it, and plain links for LinkedIn, WhatsApp, X and email.
  Array.prototype.forEach.call(document.querySelectorAll('.sharebar'), function (bar) {
    var url = bar.getAttribute('data-share-url') || location.href;
    var title = bar.getAttribute('data-share-title') || document.title;
    var toast = bar.querySelector('.share-toast');
    var say = function (m) { if (!toast) return; toast.textContent = m; toast.classList.add('show'); setTimeout(function () { toast.classList.remove('show'); }, 1800); };
    bar.addEventListener('click', function (e) {
      var el = e.target.closest && e.target.closest('[data-share]');
      if (!el) return;
      var method = el.getAttribute('data-share');
      if (method === 'copy') {
        e.preventDefault();
        if (navigator.clipboard) navigator.clipboard.writeText(url).then(function () { say('Link copied'); }, function () { say(url); });
        else say(url);
      } else if (method === 'native') {
        e.preventDefault();
        navigator.share({ title: title, url: url }).catch(function () {});
      }
    });
    var nat = bar.querySelector('[data-share="native"]');
    if (nat && navigator.share) nat.hidden = false;
  });

  // ── Dock: get a quote + back to top ───────────────────────
  // Full strength over the hero; a quieter card once the guide starts
  // (.is-past); steps aside over the form and the site footer (.is-quiet).
  var dock = document.querySelector('[data-dock]');
  if (dock) {
    var mainEl = document.querySelector('main');
    var topBtn = dock.querySelector('[data-dock-top]');
    var past = null;
    var onDockScroll = function () {
      var now = mainEl ? mainEl.getBoundingClientRect().top < innerHeight * 0.5 : scrollY > innerHeight;
      if (now === past) return;
      past = now;
      dock.classList.toggle('is-past', past);
      // As on /standard-of-employee-benefits: ↓ "Start reading" on the first
      // screen, ↑ "Back to top" once the guide starts.
      if (topBtn) topBtn.setAttribute('aria-label', past ? 'Back to top' : 'Start reading');
    };
    var dq = false;
    addEventListener('scroll', function () { if (dq) return; dq = true; requestAnimationFrame(function () { dq = false; onDockScroll(); }); }, { passive: true });
    addEventListener('resize', onDockScroll, { passive: true });
    onDockScroll();
    if ('IntersectionObserver' in window) {
      var quiet = new Map();
      var qio = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { quiet.set(e.target, e.isIntersecting); });
        dock.classList.toggle('is-quiet', Array.from(quiet.values()).some(Boolean));
      });
      [document.querySelector('section.cta'), document.querySelector('.footer-section')].forEach(function (el) { if (el) qio.observe(el); });
    }
    if (topBtn) topBtn.addEventListener('click', function () {
      var behavior = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      if (!past && mainEl) {
        var navH = parseFloat(getComputedStyle(html).getPropertyValue('--chrome-nav-h')) || 70;
        scrollTo({ top: mainEl.getBoundingClientRect().top + scrollY - navH, behavior: behavior });
        return;
      }
      scrollTo({ top: 0, behavior: behavior });
      var skip = document.querySelector('.skip-link');
      if (skip) skip.focus({ preventScroll: true });
    });
  }})();
</script>
<script is:inline>
  // Drives the plumhq.com navbar without Webflow's runtime (webflow.js and
  // IX2 are not bundled): the mobile panel and its accordion, the bar's
  // scrolled state, and the measured bar height that the report's contents
  // rail and anchor offsets use. The class contract is styled in
  // plum-chrome/chrome.css; the report fit in plum-chrome/soeb-fit.css.
  (function () {
    var root = document.querySelector('.navbar.w-nav');
    if (!root) return;
    var bar = root.querySelector('.nav') || root;
    var button = root.querySelector('.nav-hamburger');
    var menu = root.querySelector('.nav-menu');
    var html = document.documentElement;
    var DESKTOP = 992; // the chrome's own breakpoint (hover dropdowns above it)

    // Mobile panel.
    function setOpen(open) {
      root.classList.toggle('nav--menu-open', open);
      if (button) button.setAttribute('aria-expanded', open ? 'true' : 'false');
      html.style.overflow = open ? 'hidden' : '';
    }
    if (button && menu) {
      menu.id = menu.id || 'plum-nav-menu';
      button.setAttribute('role', 'button');
      button.setAttribute('tabindex', '0');
      button.setAttribute('aria-label', 'Menu');
      button.setAttribute('aria-controls', menu.id);
      button.setAttribute('aria-expanded', 'false');
      button.addEventListener('click', function () { setOpen(!root.classList.contains('nav--menu-open')); });
      button.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); button.click(); }
      });
      menu.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
      addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && root.classList.contains('nav--menu-open')) { setOpen(false); button.focus(); }
      });
    }

    // Mobile accordion. Above the breakpoint the dropdowns open on hover and
    // focus (CSS); below it there is no hover, so a tap toggles the item.
    var items = [].slice.call(root.querySelectorAll('.nav-item'));
    function closeItems() {
      items.forEach(function (o) {
        o.classList.remove('nav-item--open');
        var l = o.querySelector('.nav-item-link');
        if (l) l.setAttribute('aria-expanded', 'false');
      });
    }
    items.forEach(function (item) {
      var link = item.querySelector('.nav-item-link');
      if (!link || !item.querySelector('.nav-item-dropdown')) return;
      link.setAttribute('role', 'button');
      link.setAttribute('tabindex', '0');
      link.setAttribute('aria-expanded', 'false');
      function toggle(e) {
        if (innerWidth >= DESKTOP) return;
        e.preventDefault();
        var open = !item.classList.contains('nav-item--open');
        closeItems();
        if (open) { item.classList.add('nav-item--open'); link.setAttribute('aria-expanded', 'true'); }
      }
      link.addEventListener('click', toggle);
      link.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') toggle(e); });
    });

    // Transparent over the cover; solid once the report rolls up under the
    // bar. The cover is sticky, so measure <main>, which scrolls.
    // Here the contents bar sits above <main>, so the bar goes solid as the
    // contents bar docks under it.
    var main = document.querySelector('.toc-bar') || document.querySelector('main');
    function onScroll() {
      var past = main ? main.getBoundingClientRect().top <= bar.offsetHeight : scrollY > 24;
      root.classList.toggle('nav--scrolled', past);
    }
    // Publish the bar's real height for the contents rail and scroll-padding.
    function measure() {
      var h = Math.round((root.querySelector('.nav-container-3') || bar).getBoundingClientRect().height);
      if (h > 0) html.style.setProperty('--chrome-nav-h', h + 'px');
    }
    var queued = false;
    addEventListener('scroll', function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () { queued = false; onScroll(); });
    }, { passive: true });
    addEventListener('resize', function () {
      if (innerWidth >= DESKTOP) { closeItems(); if (root.classList.contains('nav--menu-open')) setOpen(false); }
      measure();
      onScroll();
    }, { passive: true });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    measure();
    onScroll();

    // The dock's AI card steps aside over the footer (body.at-footer).
    var footer = document.querySelector('.footer-section');
    if (footer && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        document.body.classList.toggle('at-footer', entries[0].isIntersecting);
      }).observe(footer);
    }
  })();
</script>
<script is:inline id="sales-rail-js">
(function(){
  var COPY = {
    'overview': 'Want pricing specific to your team? Talk to an expert.',
    'what-companies-spend': 'Want to know what the highest-spending companies cover? Talk to an expert.',
